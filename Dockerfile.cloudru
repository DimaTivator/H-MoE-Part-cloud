# syntax=docker/dockerfile:1

# Keep this exact base image: Cloud.ru already uses it for --image torch28,
# so its large Torch/CUDA layers can be reused from the worker-node cache.
ARG CLOUDRU_BASE=cr.ai.cloud.ru/aicloud-base-images/py3.12-torch2.8.0:0.0.42
FROM ${CLOUDRU_BASE}

USER root

# The repository itself is cloned by mlsub at job startup. The image contains
# only the environment delta, which keeps the custom pull small.
COPY requirements.cloudru.txt /tmp/requirements.cloudru.txt

RUN python -m pip install \
        --no-cache-dir \
        --upgrade-strategy only-if-needed \
        -r /tmp/requirements.cloudru.txt \
    && python -m pip check \
    && python -c 'import torch, triton, torchao, bitsandbytes, datasets, pyarrow, tensorly, tiktoken, transformers, wandb; from distributed_shampoo import DistributedShampoo; assert torch.__version__.startswith("2.8."), torch.__version__; assert torch.version.cuda and torch.version.cuda.startswith("12.8"), torch.version.cuda; assert torchao.__version__.endswith("+cu128"), torchao.__version__; assert DistributedShampoo is not None; print("Efficient-Training environment OK"); print("torch", torch.__version__, "cuda", torch.version.cuda, "triton", triton.__version__, "torchao", torchao.__version__)'

ENV HF_HOME=/home/jovyan/.cache/huggingface \
    TORCH_HOME=/home/jovyan/.cache/torch \
    TRITON_CACHE_DIR=/home/jovyan/.cache/triton

# Preserve Cloud.ru's ENTRYPOINT, sshd/HPC-X setup and working directory.
USER user
